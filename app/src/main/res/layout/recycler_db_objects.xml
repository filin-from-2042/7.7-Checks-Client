<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp">


    <LinearLayout
        android:id="@+id/containerStatusIW"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:paddingRight="8dp">

        <ImageView
            android:id="@+id/statusIW"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_check_ok"
            android:contentDescription="@string/statusIWIconDescription"/>
    </LinearLayout>


    <TextView
        android:id="@+id/objectName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/containerActionIW"
        android:layout_toRightOf="@+id/containerStatusIW"
        android:text="" />

    <LinearLayout
        android:id="@+id/containerActionIW"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="false"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:paddingLeft="8dp">

        <ProgressBar
            android:id="@+id/createPB"
            style="?android:attr/progressBarStyle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:visibility="gone"
            tools:ignore="InefficientWeight" />

        <ImageView
            android:id="@+id/actionIW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_check_notok"
            android:contentDescription="@string/actionIWIconDescription"/>
    </LinearLayout>

</RelativeLayout>