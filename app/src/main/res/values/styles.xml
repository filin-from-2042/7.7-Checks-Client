<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/secondaryColor</item>

        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>

        <item name="android:textColor">@android:color/black</item>

        <item name="android:listViewStyle">@style/ListView</item>
        <item name="buttonStyle">@style/ButtonColored</item>
        <item name="android:datePickerStyle">@style/datepicker</item>
    </style>

    <style name="AppTabLayout" parent="Widget.Design.TabLayout">
        <item name="tabBackground">@color/primaryLightColor</item>
    </style>

    <style name="ListView" parent="android:style/Widget.ListView.White" >
        <item name="android:listSelector">@drawable/list_selector_background</item>
    </style>

    <style name="TextAppearanceButtonColored" parent="TextAppearance.AppCompat.Widget.Button.Colored">
        <item name="android:textColor">@color/secondaryTextColor</item>
    </style>
    <style name="ButtonColored" parent="Base.Widget.AppCompat.Button.Colored">
        <item name="android:textAppearance">@style/TextAppearanceButtonColored</item>
        <item name="android:textColor">@color/secondaryTextColor</item>
    </style>
    <style name="ButtonBorderless" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/secondaryColor</item>
    </style>
    <style name="ButtonColoredSmall" parent="ButtonColored">
        <item name="android:minHeight">24dip</item>
        <item name="android:minWidth">48dip</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="EntryTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/entry_bg</item>
    </style>

    <style name="datepicker" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.ActionBarDark" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="actionMenuTextColor">@color/secondaryTextColor</item>
    </style>

</resources>
